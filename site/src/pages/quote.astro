---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "Get a Quote — Lustique Co.";
const desc = "Tell us about your wedding day and receive a personalised bridal hair and makeup quote within 24 hours.";
---
<BaseLayout slug="quote.html" title={title} desc={desc}>

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  
  <section class="page-hero">
    <span class="eyebrow">Get a Quote</span>
    <h1>Tell us about your day.</h1>
    <p>Every bride deserves a look as unique as her story. Build your estimate below — it updates live — then send it through for a personalised quote within 24 hours.</p>
  </section>
  <section class="section"><div class="wrap form-wrap">
    <div class="estimate-box" id="estimateBar">
      <div><div style="font-size:.74rem;letter-spacing:.14em;text-transform:uppercase;opacity:.85;">Your live estimate</div><div id="estimateSub" style="opacity:.85;font-size:.88rem;">Updates as you fill in the form</div></div>
      <div class="amt" id="estimateAmount">from R 2 890</div>
    </div>
    <form id="quoteForm">
      <input type="text" name="company" id="hp_company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;">
      <div class="form-step reveal"><h3>Your occasion</h3><p class="step-sub">The estimator is tuned for weddings — choose another occasion and the pricing switches.</p>
        <div class="field"><label>What are we creating for?</label><select id="occasion"><option value="wedding">Wedding</option><option value="matric">Matric farewell</option><option value="editorial">Editorial / photoshoot</option><option value="engagement">Engagement / maternity shoot</option><option value="corporate">Corporate / event</option><option value="pageant">Pageant / stage</option><option value="lessons">Group lesson (6+)</option></select></div>
      </div>
      <div class="form-step reveal"><h3>About you</h3><p class="step-sub">Let’s start with the star of the show.</p>
        <div class="field-row"><div class="field"><label>First name</label><input placeholder="Your name"></div><div class="field"><label>Last name</label><input placeholder="Surname"></div></div>
        <div class="field-row"><div class="field"><label>Email</label><input type="email" placeholder="you@email.com"></div><div class="field"><label>Mobile / WhatsApp</label><input placeholder="067 000 0000"></div></div>
        <div class="field"><label>How did you hear about us?</label><select><option>Instagram</option><option>Google</option><option>A friend / past bride</option><option>TikTok</option><option>Facebook</option><option>Other</option></select></div>
      </div>
      <div class="form-step reveal" id="weddingDayFields"><h3>Your big day</h3><p class="step-sub">So we can reserve the date and work out the travel from our La Montagne studio.</p>
        <div class="field-row"><div class="field"><label>Wedding date</label><input type="date"></div><div class="field"><label>Province</label><select id="provinceInput"><option>Gauteng</option><option>Limpopo</option><option>Mpumalanga</option><option>North West</option><option>Other / outside SA</option></select></div></div>
        <div class="field"><label>Venue name <span style="text-transform:none;letter-spacing:0;font-weight:400;color:#8a7d72;">(helps us pin you precisely)</span></label><input id="venueInput" placeholder="e.g. Red Ivory Estate"></div>
        <div class="field"><label>Town / area</label><input id="townInput" placeholder="e.g. Hartbeespoort"></div>
        <button type="button" class="btn btn-ghost" id="checkTravel" style="padding:.7em 1.4em;">Find venue on map</button>
        <div id="venueMap" style="height:300px;border-radius:14px;margin-top:1rem;display:none;"></div>
        <p class="note" id="mapHint" style="display:none;margin-top:.5rem;">📍 Drag the pin to your exact venue for the most accurate travel cost.</p>
        <p class="note" id="travelResult" style="margin:.85rem 0 0;">We travel from La Montagne, Pretoria — free within 30 km, then R7/km round trip.</p>
        <div class="field" id="bandWrap" style="display:none;margin-top:1rem;"><label>Distance band (fallback)</label><select id="travelBand"><option value="studio">Within 30 km (free)</option><option value="mid">30–80 km</option><option value="far">80–150 km</option><option value="veryfar">150–200 km</option><option value="destination">Over 200 km / destination</option></select></div>
      </div>
      <div id="weddingFields">
      <div class="form-step reveal"><h3>The bride</h3><p class="step-sub">Your trial and wedding-day hair &amp; makeup — lashes and a touch-up kit included.</p>
        <div class="field"><label>Bride’s hair length</label><select id="brideHairLen"><option value="short">Short (chin)</option><option value="medium" selected>Medium (shoulder)</option><option value="long">Long (mid-back)</option><option value="xlong">X-Long (pantyline)</option></select></div>
      </div>
      <div class="form-step reveal"><h3>Your bridal party</h3><p class="step-sub">Makeup and hair are priced separately — so tell us exactly who needs what, and only pay for that.</p>
        <p style="font-weight:600;color:var(--mocha);margin:.2rem 0 .6rem;">Bridesmaids</p>
        <div class="field-row"><div class="field"><label>Need makeup</label><select id="bmMakeup"><option>0</option><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option><option>6</option><option>7</option></select></div><div class="field"><label>Need hair</label><select id="bmHair"><option>0</option><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option><option>6</option><option>7</option></select></div></div>
        <p style="font-weight:600;color:var(--mocha);margin:1rem 0 .6rem;">Mothers (of the bride &amp; groom)</p>
        <div class="field-row"><div class="field"><label>Need makeup</label><select id="momMakeup"><option>0</option><option>1</option><option>2</option><option>3</option><option>4</option></select></div><div class="field"><label>Need hair</label><select id="momHair"><option>0</option><option>1</option><option>2</option><option>3</option><option>4</option></select></div></div>
        <p style="font-weight:600;color:var(--mocha);margin:1rem 0 .6rem;">Flower girls</p>
        <div class="field-row"><div class="field"><label>Age</label><select id="fgAge"><option value="under">Under 12</option><option value="over">12 and over</option></select></div><div class="field"><label>Need makeup</label><select id="fgMakeup"><option>0</option><option>1</option><option>2</option><option>3</option><option>4</option></select></div></div>
        <div class="field"><label>Flower girls — need hair</label><select id="fgHair"><option>0</option><option>1</option><option>2</option><option>3</option><option>4</option></select></div>
        <p style="font-weight:600;color:var(--mocha);margin:1rem 0 .6rem;">Other guests</p>
        <div class="field-row"><div class="field"><label>Need makeup</label><select id="guestMakeup"><option>0</option><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option></select></div><div class="field"><label>Need hair</label><select id="guestHair"><option>0</option><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option></select></div></div>
        <div class="field" style="margin-top:1rem;"><label>Most of the party’s hair length <span style="text-transform:none;letter-spacing:0;font-weight:400;color:#8a7d72;">(for your estimate — we’ll confirm each at your trial)</span></label><select id="partyHairLen"><option value="short">Short (chin)</option><option value="medium" selected>Medium (shoulder)</option><option value="long">Long (mid-back)</option><option value="xlong">X-Long (pantyline)</option></select></div>
      </div>
      </div>
      <div class="form-step reveal" id="eventFields" style="display:none;"><h3>Who needs makeup &amp; hair?</h3><p class="step-sub">Tell us how many people need each — only pay for what you book.</p>
        <div class="field"><label>Date of your event</label><input type="date"></div>
        <div class="field-row"><div class="field"><label>Need makeup</label><select id="evMakeup"><option>0</option><option selected>1</option><option>2</option><option>3</option><option>4</option><option>5</option><option>6</option><option>7</option><option>8</option></select></div><div class="field"><label>Need hair</label><select id="evHair"><option selected>0</option><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option><option>6</option><option>7</option><option>8</option></select></div></div>
        <div class="field"><label>Hair length <span style="text-transform:none;letter-spacing:0;font-weight:400;color:#8a7d72;">(for any hair styling)</span></label><select id="evHairLen"><option value="short">Short (chin)</option><option value="medium" selected>Medium (shoulder)</option><option value="long">Long (mid-back)</option><option value="xlong">X-Long (pantyline)</option></select></div>
      </div>
      <div class="form-step reveal" id="lessonsFields" style="display:none;"><h3>Your group lesson</h3><p class="step-sub">Learn to do your own makeup with us — groups of 6 or more, at Bez Ranch or on location.</p>
        <div class="field"><label>Preferred date</label><input type="date"></div>
        <div class="field"><label>How many attending? <span style="text-transform:none;letter-spacing:0;font-weight:400;color:#8a7d72;">(6 minimum · R700pp, R600pp for 10+)</span></label><select id="lessonsAttending"><option>6</option><option>7</option><option>8</option><option>9</option><option>10</option><option>12</option><option>15</option><option>20</option></select></div>
      </div>
      <div class="form-step reveal"><h3>Your vision</h3><p class="step-sub">The more you share, the more we can tailor your day.</p>
        <div class="field"><label>Style</label><select><option>Natural &amp; soft</option><option>Soft glam</option><option>Full glam</option><option>Editorial</option><option>Boho</option><option>Not sure yet — guide me</option></select></div>
        <div class="field"><label>Inspiration link (Pinterest / Instagram)</label><input placeholder="Paste a link — optional"></div>
        <div class="field"><label>Anything else we should know? (skin notes, timings, special requests)</label><textarea rows="4" placeholder="Tell us anything that helps us prepare…"></textarea></div>
        <div id="promoRow"><label style="display:flex;align-items:center;gap:.6rem;font-size:.92rem;color:#5c5048;margin:.2rem 0 1.3rem;"><input type="checkbox" id="promoToggle" checked style="width:auto;"> Apply the “book 4+, least-expensive look free” offer to my estimate</label></div>
        <a class="btn btn-primary" href="thank-you.html" style="width:100%;justify-content:center;">Send my enquiry</a>
        <p class="note center" style="margin-top:1rem;">Prototype form — not yet connected. In the live build this writes to the CRM, emails your confirmation, and starts your quote. <strong>Blessings, The Lustique Cosmetology Team.</strong></p>
      </div>
    </form>
  </div></section>
  <script>import "../scripts/estimator.ts";</script>
</BaseLayout>
