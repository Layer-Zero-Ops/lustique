---
/* Real responsive image with blur-up reveal. The .ph container keeps all the
   existing layout CSS (aspect-ratio, radius, hover-zoom); the <img> inside fades
   + sharpens from the champagne placeholder once it loads (site.js adds .loaded).
   Multi-size srcset + true LQIP arrive with the Sanity image CDN in Pass 2. */
interface Props { src: string; alt: string; cls?: string; eager?: boolean; }
const { src, alt, cls = "", eager = false } = Astro.props as Props;
---
<div class={`ph img ${cls}`}>
  <img
    class="ph-img"
    src={`assets/${src}`}
    alt={alt}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
  />
</div>
